<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) traffic for the Vercel domain during development.
         Remove cleartextTrafficPermitted in production and serve over HTTPS only. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">acum.vercel.app</domain>
    </domain-config>
</network-security-config>
