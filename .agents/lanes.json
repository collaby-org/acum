{
  "lanes": [
    {
      "id": "reviews-core",
      "role": "write",
      "paths": [
        "monorepo/frontend/src/components/reviews/popular-reviews.tsx",
        "monorepo/frontend/src/components/reviews/review-card.tsx",
        "monorepo/frontend/src/components/reviews/review-composer.tsx",
        "monorepo/frontend/src/components/reviews/types.ts",
        "monorepo/frontend/src/components/reviews/index.ts",
        "monorepo/frontend/src/hooks/use-reviews.ts",
        "monorepo/frontend/src/lib/reviews.ts",
        "monorepo/frontend/src/app/api/reviews"
      ],
      "outputs": [
        "the review engine: a read, a write, an edit and a delete, under the visitor's own token",
        "the visitor's own review, read back with its mine flag",
        "the channel surface manages that review: edit, delete, and a trigger that says which"
      ]
    },
    {
      "id": "reviews-entry",
      "role": "write",
      "paths": [
        "monorepo/frontend/src/components/channel/channel-panel.tsx",
        "monorepo/frontend/src/components/channel/index.ts",
        "monorepo/frontend/src/components/header.tsx",
        "monorepo/frontend/src/app/page.tsx",
        "monorepo/frontend/src/app/canale/page.tsx",
        "monorepo/frontend/src/app/canal/[id]/page.tsx"
      ],
      "outputs": [
        "a discoverable 'Scrie o recenzie' on the channel surface",
        "the popular reviews sit where the eye lands"
      ]
    },
    {
      "id": "player-polish",
      "role": "write",
      "paths": [
        "monorepo/frontend/src/components/player",
        "monorepo/frontend/src/components/programme-badges",
        "monorepo/frontend/src/components/ui/dialog.tsx"
      ],
      "outputs": [
        "one badge vocabulary for the whole app",
        "44px mute, warning, dialog and volume targets with a visible volume value",
        "the browser's Back button closes the player"
      ]
    },
    {
      "id": "mobile-polish",
      "role": "write",
      "paths": [
        "monorepo/frontend/src/app/error.tsx",
        "monorepo/frontend/src/app/not-found.tsx",
        "monorepo/frontend/src/app/global-error.tsx",
        "monorepo/frontend/src/app/reset-password",
        "monorepo/frontend/src/components/pages",
        "monorepo/frontend/src/components/admin",
        "monorepo/frontend/src/components/search-panel.tsx"
      ],
      "outputs": [
        "no input zooms the page on iOS (16px on mobile)",
        "the error shells use a dynamic viewport unit",
        "every remaining touch target is at least 44px"
      ]
    },
    {
      "id": "nav-bar",
      "role": "write",
      "paths": [
        "monorepo/frontend/src/components/mobile-nav.tsx",
        "monorepo/frontend/src/app/canale/loading.tsx"
      ],
      "outputs": [
        "the bottom bar marks the current route",
        "a loading boundary for /canale that does not jump"
      ]
    },
    {
      "id": "tv-reviews",
      "role": "write",
      "paths": [
        "monorepo/tv/src/components/reviews/popular-reviews.tsx",
        "monorepo/tv/src/components/reviews/reaction-row.tsx",
        "monorepo/tv/src/components/reviews/review-card.tsx",
        "monorepo/tv/src/components/reviews/review-composer.tsx",
        "monorepo/tv/src/components/reviews/types.ts",
        "monorepo/tv/src/components/reviews/index.ts",
        "monorepo/tv/src/components/channel/channel-panel.tsx",
        "monorepo/tv/src/app/page.tsx",
        "monorepo/tv/src/app/api/reviews",
        "monorepo/tv/src/hooks/use-reviews.ts",
        "monorepo/tv/src/lib/reviews.ts",
        "monorepo/tv/src/lib/review-rank.ts",
        "monorepo/tv/src/lib/review-channels.ts"
      ],
      "outputs": [
        "the same engine in the television app, under the visitor's own token",
        "the popular reviews below the hero, and the composer on the channel panel",
        "the channel surface manages the visitor's own review"
      ]
    },
    {
      "id": "tv-parity",
      "role": "write",
      "paths": [
        "monorepo/tv/src/app/globals.css",
        "monorepo/tv/src/app/error.tsx",
        "monorepo/tv/src/app/not-found.tsx",
        "monorepo/tv/src/components/browse.tsx",
        "monorepo/tv/src/components/pages/shell.tsx",
        "monorepo/tv/public/manifest.webmanifest",
        "monorepo/tv/public/sw.js",
        "monorepo/tv/src/components/player/player-controls.tsx"
      ],
      "outputs": [
        "the phone rules the web app already follows: the dynamic viewport, the text size, the tap, the overscroll, the hover",
        "one control size for the whole transport bar, and a volume the viewer can read",
        "the service worker drops the dead asset cache, and the manifest opens the app where the app lives"
      ]
    },
    {
      "id": "overlay-history",
      "role": "write",
      "paths": [
        "monorepo/frontend/src/components/reviews/zoom-overlay.tsx",
        "monorepo/tv/src/components/reviews/zoom-overlay.tsx",
        "monorepo/tv/src/components/reviews/star-rating.tsx"
      ],
      "outputs": [
        "Back closes the sheet, and the page behind comes back where it was",
        "one size for the stars: 44px, the same as the reaction row beside them"
      ]
    },
    {
      "id": "verify-reviews",
      "role": "write",
      "paths": [
        "monorepo/frontend/scripts/verify-reviews.mjs"
      ],
      "outputs": [
        "the harness that proves the whole life of a review, and cleans up after itself"
      ]
    },
    {
      "id": "orchestrator",
      "role": "write",
      "paths": [
        ".agents/lanes.json",
        "docs",
        "README.md",
        "monorepo/frontend/README.md",
        "monorepo/frontend/package.json",
        "monorepo/tv/package.json"
      ],
      "outputs": [
        "the changelog, the backlog, the verification log, the README and the diagrams",
        "the version line that moves with every release",
        "the proof scripts, run against the deployed site"
      ]
    }
  ]
}
