        "monorepo/frontend/src/lib/programme-badges.ts",
        "monorepo/frontend/src/components/programme-badges/badge-row.tsx"
      ],
      "outputs": [
        "landing hydration fixed, reviews reachable, programme leads the panel, one quality badge per channel"
      ]
    },
    {
      "id": "player-controls",
      "role": "write",
      "paths": [
        "monorepo/frontend/src/components/player/player-controls.tsx",
        "monorepo/frontend/src/components/player/video-player.tsx",
        "monorepo/frontend/src/components/player/player-quality.tsx"
