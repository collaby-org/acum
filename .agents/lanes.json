    {
      "id": "orchestrator",
      "role": "write",
      "paths": [
        ".github/workflows",
        "monorepo/frontend/data/epg.json",
        "docs/VERSION",
        "docs/changelog.md",
        "monorepo/frontend/package.json",
        "monorepo/tv/package.json",
        ".agents/lanes.json"
      ],
      "outputs": [
        "scheduled EPG refresh, one version line, changelog, release notes"
      ]
    },
    {
      "id": "audit-readers",
      "role": "read",
      "paths": [
        "monorepo/frontend/src",
        "monorepo/tv/src"
      ]
