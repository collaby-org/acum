{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "model": "opencode/muse-spark-1.3-contributor-free",
  "small_model": "openai/z-ai/glm-5.3-flash",
  "skills": ["./.agents/skills"],
  "provider": {
    "opencode": {
      "options": { "apiKey": "{env:OPENCODE_API_KEY}" },
      "models": {
        "muse-spark-1.3-contributor-free": { "name": "Muse Spark 1.3 Contributor (Free)" }
      }
    },
    "openai": {
      "options": { "baseURL": "https://integrate.api.nvidia.com/v1", "apiKey": "{env:LLM_API_KEY}" },
      "models": {
        "deepseek-ai/deepseek-v4.1-flash": { "name": "DeepSeek V4.1 Flash (NVIDIA, 1M ctx)" },
        "z-ai/glm-5.3-flash": { "name": "GLM 5.3 Flash (NVIDIA, 1M ctx)" },
        "stepfun-ai/step-5-preview": { "name": "Step 5 Preview (NVIDIA, 1M ctx)" },
        "nvidia/nemotron-3.5-super-vl-120b-a12b": { "name": "Nemotron 3.5 Super VL 120B A12B (NVIDIA, 1M ctx)" }
      }
    },
    "tokenharbor": {
      "name": "Token Harbor",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://tokenharbor.ai/v1",
        "apiKey": "{env:TOKENHARBOR_API_KEY}"
      },
      "models": {
        "th-orchestra": { "name": "Token Harbor" },
        "muse-spark-1.3": { "name": "Muse Spark 1.3 (Token Harbor)" },
        "deepseek-v4.1-flash:free": { "name": "DeepSeek V4.1 Flash" },
        "deepseek-v4-flash:free": { "name": "DeepSeek V4 Flash" },
        "mimo-v2.5:free": { "name": "MiMo V2.5" }
      }
    },
    "omnirouter": {
      "name": "Omni Router",
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "http://localhost:20128/v1" },
      "models": {
        "auto": { "name": "OmniRoute Auto" }
      }
    }
  }
}
