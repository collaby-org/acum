Obsidian-Vault/dist/

# Shared Node / misc
node_modules/
npm-debug.log*
yarn-error.log*
coverage/
.nyc_output/

# Laravel — local install marker (per-machine state, never commit)
v1/Obsidian-Core/storage/installed
v2 - laravel/Obsidian-Core-V2/storage/installed

# Local backups (never commit)
AGENTS.md.20261003.bak

# Live websocket capture produced by the render-loop harness (regenerate: node scripts/render-loop-harness/capture.cjs)
_frames.json

# Git worktrees live here (the main checkout stays on its own branch).
# Without this, `git add .` offers each worktree as an embedded repository
# and git suggests adding it as a submodule.
.worktrees/

# Agent scratch: probe scripts and backups must never reach the repo.
zz_*.php
zz_*.txt
zz_*.bak
*_probe.php
*_probe_*.php
*_ddl_probe.php
*.bak