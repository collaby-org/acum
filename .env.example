# ---------------------------------------------------------------------------
# ACUM — environment template.
#
# Copy to `.env` and fill in. Every name here is read by the app or by the
# verification scripts; nothing else is expected. `.env` is gitignored.
#
# On Vercel: Project → Settings → Environment Variables. NEXT_PUBLIC_* are
# inlined into the browser bundle at build time, so they must be set before
# the build — a preview deployment without them cannot sign anybody in.
# ---------------------------------------------------------------------------

# Supabase — project URL and publishable key. The publishable key ships in
# the browser bundle by design; row level security is what keeps the data
# closed. Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role key. Server-only: it bypasses row level security
# and must never reach a browser bundle. The admin desk and the Stripe
# webhook fail with a readable error until it is set.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — secret key and webhook signing secret. While they are empty the
# pricing page says so honestly and /api/checkout answers configured:false.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The harness account the browser verification scripts sign in with
# (verify-player, verify-ui, capture-posters, …). Without it they measure
# the paywall instead of the product.
ACUM_HARNESS_EMAIL=
ACUM_HARNESS_PASSWORD=

# Comma-separated emails that may open /admin without a granted plan.
ADMIN_EMAILS=

# The deployed origin — metadata, canonical URLs, Stripe return URL.
NEXT_PUBLIC_SITE_URL=
