{
  "_doc": {
    "purpose": "ITVX-style programme metadata: accessibility flags, genre and age rating, curated against what we can honestly verify. data/epg.json carries only title + times + description, so every value here is authored by hand or derived in src/lib/programme-badges.ts (heuristics). Nothing here is a machine guess.",
    "keys": "channels are keyed by catalogue id (src/data/channels.ts); programmes are keyed by the normalized title — lowercase, diacritics stripped. The resolver folds both sides the same way, so catalogue id and epg slug match (pro-tv == protv).",
    "flags": {
      "legend": "AD = audiodescriere, S = subtitrare, SSL = limbaj în semne.",
      "rule": "Per-channel flags are set only where the channel broadcasts them as a rule and it is well known: news -> [S, AD]; sport -> [AD]; kids -> [S]; public TVR -> [S, AD] (subtitles + audio description are mandated). SSL is the rarest and most programme-specific, so no channel claims it. Every other channel leaves flags off rather than inventing a subtitle it may not carry."
    },
    "rating": {
      "rule": "Ratings are programme-only — never a channel default, never a heuristic. 18 is reserved for genuinely adult / violent true crime with a Romanian reason; PG for family, lifestyle and entertainment (guidance, not restrictive); news and kids carry no rating. When in doubt the rating is left null: a wrong 18 is worse than no pill.",
      "labels": "PG, 12, 18 follow the ITVX-style scale the brief specified; 'AP' is deliberately unused in favour of leaving news unrestricted."
    }
  },
